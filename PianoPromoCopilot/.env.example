# ============================================================
# PianoPromoCopilot - Configuration Key Reference
# ============================================================
# This file DOCUMENTS the available configuration keys. The .NET
# app does NOT load a .env file, so editing a copy of this file
# alone has no effect on `dotnet run`.
#
# To actually apply a value, supply it either:
#   1. in appsettings.json / appsettings.Development.json, or
#   2. as a real exported environment variable, using the
#      double-underscore form shown below to denote nesting
#      (Foo__Bar maps to the "Foo": { "Bar": ... } section):
#        export OpenAI__ApiKey=sk-...
#
# Docker Compose is the one tool here that reads a .env file: it
# auto-loads one placed next to docker-compose.yml for ${VAR}
# substitution and container environment.
#
# Defaults below already run the app fully in mock mode - no
# OpenAI key, no YouTube credentials, no SQL Server/Docker.
# NEVER commit a .env containing real secrets to source control.
# ============================================================

# SQL Server (Docker)
MSSQL_SA_PASSWORD=PianoPromo@2024
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=PianoPromoCopilot;User Id=sa;Password=PianoPromo@2024;TrustServerCertificate=True;

# OpenAI - Leave blank to use deterministic mock LLM
OpenAI__ApiKey=your-openai-api-key-here
OpenAI__Model=gpt-4o-mini
OpenAI__BaseUrl=https://api.openai.com/v1/

# Feature Flags
# Set UseMockYouTube=false and configure Google OAuth to use real YouTube
Features__UseMockYouTube=true
Features__EnableYouTubeWriteActions=false
Features__UseMockAnalytics=true
# UseInMemoryDatabase=true runs with no SQL Server/Docker at all (data resets on restart).
# Set it to false to use the ConnectionStrings__DefaultConnection above.
Features__UseInMemoryDatabase=true

# Google OAuth (YouTube integration - configure after basic setup is working)
Google__ClientId=your-google-client-id
Google__ClientSecret=your-google-client-secret
Google__RedirectUri=http://localhost:5000/auth/google/callback

# Development settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
